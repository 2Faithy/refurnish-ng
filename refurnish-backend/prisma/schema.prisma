// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  password  String?

  emailVerified     Boolean  @default(false)
  verificationCode  String?

  resetCode        String?
  resetCodeExpiry  DateTime?

  provider    String   @default("local")
  googleId    String?  @unique
  facebookId  String?  @unique

  profileImage String?
  whatsapp     String?

  address String?
  state   String?
  lga     String?
  city    String?

  idType             String?
  idNumber           String?
  idImage            String?
  idVerified         Boolean   @default(false)
  idVerifiedAt       DateTime?
  idRejectionReason  String?
  idReviewedAt       DateTime?

  emailNotifications Json?
  pushNotifications  Json?
  smsNotifications   Json?

  passwordChangedAt DateTime?

  bankName             String?
  accountNumber        String?
  accountName          String?
  bankDetailsUpdatedAt DateTime?

  preferences   Json?
  deactivatedAt DateTime?
  deletedAt     DateTime?
  tokenVersion  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings Listing[]
  orders   Order[]
  payouts  Payout[]

  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  supportTickets      SupportTicket[]

  @@map("users")
}

model Review {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  buyerId    String
  rating     Int
  comment    String?
  recommend  Boolean?
  createdAt  DateTime @default(now())

  @@map("reviews")
}

model Dispute {
  id          String    @id @default(uuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  buyerId     String
  reason      String
  description String
  status      String    @default("open") // open | reviewing | resolved
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("disputes")
}

model SellerConfirmation {
  id           String    @id @default(uuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id])
  sellerEmail  String
  sellerName   String
  token        String    @unique
  items        Json
  availability String?   // null | "available" | "unavailable"
  respondedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@map("seller_confirmations")
}

model Order {
  id          String   @id @default(uuid())
  reference   String   @unique // e.g. RF-000001
  referenceSeq Int     @unique @default(autoincrement())

  buyerId     String
  buyer       User     @relation(fields: [buyerId], references: [id])

  items       Json     // snapshot of listing(s) at time of purchase
  subtotal    String
  buyerProtection String
  total       String

  deliveryType String   // "pickup" | "delivery"
  fullName    String
  phone       String
  email       String
  address     String?
  state       String?
  lga         String?
  landmark    String?
  deliveryDate String?
  deliveryNotes String?

  paymentMethod String  // "paystack" | "transfer"
  paystackReference String?
  receiptUrl  String?

  status      String   @default("pending_payment") 
  // pending_payment -> pending_verification (transfer) -> confirmed -> rejected
  // paystack: pending_payment -> confirmed (auto) 

  rejectionReason String?
  reviewedAt  DateTime?

  sellerConfirmations SellerConfirmation[]
  reviews             Review[]
  disputes            Dispute[]
  conversations       Conversation[]
  payouts             Payout[]
  supportTickets      SupportTicket[]

  deliveryConfirmedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("orders")
}

model Listing {
  id          String   @id @default(uuid())
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id])

  photos      String[]
  itemTitle   String
  category    String
  brand       String?
  model       String?

  condition       String
  defects         String[]
  conditionNotes  String?
  age             String
  color           String
  material        String

  dimLength   String?
  dimWidth    String?
  dimHeight   String?
  dimWeight   String?

  description String
  tags        String[]

  originalPrice String?
  sellingPrice  String
  negotiable    Boolean @default(true)
  sellReason    String?
  availability  String?
  urgency       String?

  sellerName  String
  phone       String
  email       String?
  whatsapp    String?
  callTime    String?

  address        String
  state          String
  lga            String?

  warranty         String?
  warrantyDuration String?

  status          String   @default("pending")
  rejectionReason String?
  reviewedAt      DateTime?

  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("listings")
}

model Conversation {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])

  buyerId String
  buyer   User   @relation("BuyerConversations", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("SellerConversations", fields: [sellerId], references: [id])

  offerAmount String? // current/last offer amount from buyer
  offerStatus String? // "pending" | "accepted" | "rejected" | "completed"
  agreedPrice String? // set once offerStatus = "accepted"

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  buyerLastReadAt  DateTime?
  sellerLastReadAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([listingId, buyerId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderId String? // null for system messages
  role     String  // "buyer" | "seller" | "system"
  type     String  @default("text") // "text" | "offer" | "offer_accepted" | "offer_rejected"

  text        String
  offerAmount String?

  createdAt DateTime @default(now())

  @@map("messages")
}

model Payout {
  id String @id @default(uuid())

  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id])

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  listingId String?
  itemTitle String

  grossAmount String
  feePercent  Int    @default(24)
  feeAmount   String
  netAmount   String

  status     String    @default("pending") // "pending" | "paid"
  receiptUrl String?
  paidAt     DateTime?

  issueReported    Boolean @default(false)
  issueDescription String?
  issueStatus      String? // "open" | "resolved"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payouts")
}

model SupportTicket {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  topic  String  @default("general")
  status String  @default("open") // "open" | "waiting_for_agent" | "resolved"

  userLastReadAt  DateTime?
  adminLastReadAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]

  @@map("support_tickets")
}

model SupportMessage {
  id String @id @default(uuid())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id])

  role        String // "user" | "agent" | "system"
  text        String
  attachments Json?

  createdAt DateTime @default(now())

  @@map("support_messages")
}